<!DOCTYPE html>
<html>
<head>
  <title><%= book.title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
</head>
<body>
   <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/books">Books</a></li>
      </ul>
    </nav>

    <main class="index">
<h1> Edit book <%= book.title %> (<%= book.id %>) </h1>
<form action="/books/<%= book.id %>/edit" method="POST" class="edit-form">
    <div>
        <label>Title: <input type="text" name="title" value="<%= book.title %>"></label>
    </div>
    <div>
        <label>Author: <input type="text" name="author" value="<%= book.author %>"></label>
    </div>
    <div>
        <label>Year: <input type="number" name="year" value="<%= book.year %>"></label>
    </div>
    <input type="submit" value="Update Book">
</form>
<ul class="action-list">
    <li> <a href="/books/<%= book.id %>">Back to list</a></li>
    <li>
        <form action="/books/<%= book.id %>/delete" method="POST">
            <input type="submit" value="Delete Book" onclick="return confirm('Are you sure you want to delete this book?');">
        </form>
    </li>
</ul>
</main>>
</body>
</html>